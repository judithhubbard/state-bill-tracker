# Fresh downloads are rebuilt every run; only past sessions are kept, gzipped.
data/*.json
data/*.tmp
site/
_site/
__pycache__/
.DS_Store
!data/contacts_*.json
!data/assembly_votes_*.json
!data/seat_parties.json
!data/ny_places.json
!data/district_counties.json
!data/session_calendar.json
lists_worker/.wrangler/
cron_worker/.wrangler/
lists_worker/node_modules/
# New Jersey downloads (states/nj/fetch.py); not kept in git yet.
data/nj/*
!data/nj/district_towns.json
# 2022-23's download lacks tables; this copy is filled in once by states/nj/fill2022.py.
!data/nj/DB2022_TEXT.zip
# Virginia downloads (states/va/fetch.py).
data/va/*
# California downloads (states/ca/fetch.py); its county table is made once by states/ca/towns.py.
data/ca/*
!data/ca/district_towns.json
# Texas downloads (states/tx/fetch.py); its county table is made once by states/tx/towns.py.
data/tx/*
!data/tx/district_towns.json
# Illinois downloads (states/il/fetch.py); its place table is made once by states/il/towns.py.
data/il/*
!data/il/district_towns.json
